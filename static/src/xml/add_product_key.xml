<?xml version="1.0" encoding="utf-8"?>

<templates id="template"
    xml:space="preserve">
    <t t-name="add_product_key.ProductCard_inherit"
        t-inherit="point_of_sale.ProductCard"
        t-inherit-mode="extension"
        owl="1">
        <xpath expr="//div[contains(@class,'product-content')]//div[contains(@class,'product-name')]"
            position="after">
            <div class="overflow-hidden lh-sm product-name text-break">
                <t t-if="props.product.default_code">
                    <span class="text-muted"
                        style="font-size: 15px;"
                        t-esc="props.product.default_code"/>
                </t>
            </div>
        </xpath>
    </t>
</templates>
