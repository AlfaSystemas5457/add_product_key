<?xml version="1.0" encoding="utf-8"?>

<templates id="template"
    xml:space="preserve">
    <t t-name="add_product_key.Orderline_inherit"
        t-inherit="point_of_sale.Orderline"
        t-inherit-mode="extension"
        owl="1">
        <xpath expr="//div[contains(@class,'product-name')]//span[contains(@class,'text-wrap d-inline')]//t"
            position="after">
            <t t-if="line.product_id.default_code">
                <br/>
                <small style="font-size: 12px;"
                    t-esc="line.product_id.default_code"/>
            </t>
        </xpath>
    </t>
</templates>
